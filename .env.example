# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# MongoDB connection string. The application connects with Mongoose only —
# there is no CMS layer holding a second connection any more.
DATABASE_URI="mongodb://127.0.0.1/native-ecommerce"

# HMAC key used to sign native session tokens (src/lib/auth/session.ts).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every issued session.
SESSION_SECRET=

# Public origin of this deployment. Used for absolute URLs (payment
# redirects, Open Graph metadata, image host allow-list).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Paynow (the only payment provider)
# ---------------------------------------------------------------------------
# Server-side only — never prefix these with NEXT_PUBLIC_.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# "test" replays Paynow's sandbox behaviour; "live" hits production.
PAYNOW_MODE=test
# Optional explicit URLs. When unset they are derived from the request origin:
#   result url -> /api/payments/paynow/callback   (authoritative, server-to-server)
#   return url -> /api/payments/paynow/return     (browser redirect, never proof of payment)
# Set them explicitly in production, where the origin behind a proxy may differ.
PAYNOW_RESULT_URL=
PAYNOW_RETURN_URL=

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------

# Where uploaded files are written. Defaults to ./media next to the app.
# Deliberately NOT inside public/: uploads are served by a route handler
# (/media/<filename>) rather than as static assets, so the application
# decides what is served. Point this at a persistent volume in production —
# a container filesystem is not one.
MEDIA_DIR=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Port for `next dev` / `next start` (defaults to 3000).
PORT=3000

# Set to any non-empty value in production so the app is indexable.
# When empty, every response carries X-Robots-Tag: noindex.
NEXT_PUBLIC_IS_LIVE=

# Shared secrets for the draft-preview and on-demand revalidation routes.
NEXT_PRIVATE_DRAFT_SECRET=
NEXT_PRIVATE_REVALIDATION_KEY=

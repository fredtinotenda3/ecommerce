{
  "name": "native-ecommerce",
  "description": "Next.js + Mongoose + Paynow e-commerce application (Payload/Stripe free)",
  "version": "2.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint --fix --ext .ts,.tsx src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:admin": "ts-node -T scripts/seed/createAdminUser.ts",
    "seed:store": "ts-node -T scripts/seed/seedStore.ts",
    "migration:products:prices": "ts-node -T scripts/migrations/backfillProductPrices.ts",
    "migration:products:legacy-stripe-id": "ts-node -T scripts/migrations/preserveProductLegacyStripeId.ts",
    "migration:users:legacy-stripe-id": "ts-node -T scripts/migrations/preserveUserLegacyStripeId.ts",
    "migration:orders:backfill": "ts-node -T scripts/migrations/backfillOrders.ts",
    "migration:payments:backfill-historical": "ts-node -T scripts/migrations/backfillHistoricalStripePayments.ts",
    "validate:db": "ts-node -T scripts/validation/checkDatabaseConnectivity.ts",
    "validate:paynow": "ts-node -T scripts/validation/checkPaynowConfig.ts",
    "validate:env": "ts-node -T scripts/validation/checkEnvironment.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "escape-html": "^1.0.3",
    "mongoose": "^6.12.0",
    "next": "13.5.11",
    "qs": "6.11.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.45.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^13.5.2",
    "@swc/core": "^1.16.2",
    "@types/escape-html": "^1.0.2",
    "@types/node": "18.11.3",
    "@types/qs": "^6.9.8",
    "@types/react": "18.0.21",
    "@types/react-dom": "18.0.6",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "prettier": "^2.8.8",
    "sass": "^1.69.5",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
